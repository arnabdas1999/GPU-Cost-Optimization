{
  "uid": "rc-runs",
  "title": "Rollout Cost Lab \u00b7 Runs",
  "tags": [
    "rollout-cost",
    "history"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Runs** \u2014 every exported run. Click a run id to open its detail dashboard at the run's time window. Rows marked SYNTHETIC came from the scripted model or the mock server and are not GPU evidence. Load data with `rollout-cost export`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Measured runs",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT count(*) AS measured FROM runs WHERE NOT synthetic",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Synthetic runs",
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT count(*) AS synthetic FROM runs WHERE synthetic",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Experiments",
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT count(*) AS experiments FROM experiments WHERE kind = 'paired'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sweeps",
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT count(*) AS sweeps FROM experiments WHERE kind = 'sweep'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Runs",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT run_id, CASE WHEN synthetic THEN 'SYNTHETIC' ELSE 'measured' END AS data, config_name, label, max_active_episodes AS episode_cap, max_inflight_llm_requests AS request_cap, tool_workers, successes, valid_episodes AS valid, cohort_size AS submitted, infra_errors, wall_timeouts, window_s, window_cost, cost_per_success, warnings_count AS warnings, created_utc, start_ms, end_ms FROM runs ORDER BY created_utc DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "start_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "end_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run",
                    "url": "/d/rc-run-detail/rollout-cost-lab-run-detail?var-run=${__value.raw}&from=${__data.fields.start_ms}&to=${__data.fields.end_ms}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "data"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SYNTHETIC": {
                        "text": "SYNTHETIC",
                        "color": "#8f3bb8",
                        "index": 0
                      },
                      "measured": {
                        "text": "measured",
                        "color": "#37872d",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "window_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "window_cost|cost_per_success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Allocated window by run (latest 15)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT run_label, window_s FROM (SELECT config_name || ' \u00b7 ' || right(run_id, 4) AS run_label, window_s, created_utc FROM runs ORDER BY created_utc DESC LIMIT 15) t ORDER BY created_utc",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "xField": "run_label",
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -30
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Successes / valid / submitted (latest 15)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT run_label, successes, valid, submitted FROM (SELECT config_name || ' \u00b7 ' || right(run_id, 4) AS run_label, successes, valid_episodes AS valid, cohort_size AS submitted, created_utc FROM runs ORDER BY created_utc DESC LIMIT 15) t ORDER BY created_utc",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "xField": "run_label",
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -30
      }
    }
  ],
  "links": [
    {
      "title": "Rollout Cost Lab",
      "type": "dashboards",
      "tags": [
        "rollout-cost"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "annotations": {
    "list": []
  }
}
