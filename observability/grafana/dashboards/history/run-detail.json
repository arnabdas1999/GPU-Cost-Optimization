{
  "uid": "rc-run-detail",
  "title": "Rollout Cost Lab \u00b7 Run detail",
  "tags": [
    "rollout-cost",
    "history"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "run",
        "label": "Run",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "rc-postgres"
        },
        "query": "SELECT run_id FROM runs ORDER BY created_utc DESC",
        "definition": "SELECT run_id FROM runs ORDER BY created_utc DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Data",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT CASE WHEN synthetic THEN 'SYNTHETIC \u2014 ' || coalesce(synthetic_reason, '') ELSE 'Measured run' END AS data FROM runs WHERE run_id = '$run'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "SYNTHETIC.*",
                "result": {
                  "color": "#8f3bb8"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "Measured run": {
                  "color": "#37872d"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Run window (click to zoom the dashboard to this run)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT run_id, config_name, model, gpu, executor, cache_reset, start_ms, end_ms FROM runs WHERE run_id = '$run'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "start_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "end_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Zoom to run",
                    "url": "/d/rc-run-detail/rollout-cost-lab-run-detail?var-run=${__value.raw}&from=${__data.fields.start_ms}&to=${__data.fields.end_ms}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Cost basis",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT hourly_rate, currency, CASE WHEN hourly_rate IS NULL THEN 'Unknown rate' WHEN EXISTS ( SELECT 1 FROM run_warnings cost_warning WHERE cost_warning.run_id = runs.run_id AND cost_warning.message LIKE 'Estimated equivalent cost:%') THEN 'Estimated equivalent' ELSE 'Recorded rate' END AS basis, (SELECT message FROM run_warnings cost_warning WHERE cost_warning.run_id = runs.run_id AND cost_warning.message LIKE 'Estimated equivalent cost:%' ORDER BY ordinal LIMIT 1) AS assumption FROM runs WHERE run_id = '$run'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
