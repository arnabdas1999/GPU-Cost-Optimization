      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT x_label, max(successes) FILTER (WHERE role = 'baseline') AS baseline, max(successes) FILTER (WHERE role = 'candidate') AS candidate FROM experiment_trials WHERE experiment = '$experiment' GROUP BY x_label ORDER BY min(ordinal)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
