{
  "uid": "rc-experiments",
  "title": "Rollout Cost Lab \u00b7 Experiments and sweeps",
  "tags": [
    "rollout-cost",
    "history"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "experiment",
        "label": "Experiment / sweep",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "rc-postgres"
        },
        "query": "SELECT name FROM experiments ORDER BY kind, name",
        "definition": "SELECT name FROM experiments ORDER BY kind, name",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cost interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Cost values use recorded allocation rates or estimated equivalent rates. Open a run's Cost basis for the assumption and source. Reference valuations are estimates, not Colab charges."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Decision",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT verdict FROM experiments WHERE name = '$experiment'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "ACCEPTED": {
                  "color": "#37872d"
                },
                "NOT ACCEPTED": {
                  "color": "#e02f44"
                },
                "A/A CALIBRATION": {
                  "color": "#3274d9"
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "CHOSEN.*",
                "result": {
                  "color": "#3274d9"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Data",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT CASE WHEN synthetic THEN 'SYNTHETIC' ELSE 'measured' END AS data FROM experiments WHERE name = '$experiment'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "SYNTHETIC": {
                  "color": "#8f3bb8"
                },
                "measured": {
                  "color": "#37872d"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kind / status",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT kind || ' \u00b7 ' || coalesce(status, '') AS kind FROM experiments WHERE name = '$experiment'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
