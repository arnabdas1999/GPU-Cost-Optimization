      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT x_label, role, candidate, run_id, max_active_episodes AS episode_cap, max_inflight_llm_requests AS request_cap, window_s, window_cost, successes, valid_episodes AS valid, cohort_size AS submitted, infra_errors FROM experiment_trials WHERE experiment = '$experiment' ORDER BY ordinal",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
