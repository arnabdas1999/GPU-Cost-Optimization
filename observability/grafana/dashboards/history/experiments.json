    {
      "id": 10,
      "type": "table",
      "title": "Acceptance checks",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rc-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rc-postgres"
          },
          "rawSql": "SELECT candidate, check_name AS check, CASE WHEN ok THEN 'pass' ELSE 'FAIL' END AS result, detail FROM acceptance_checks WHERE experiment = '$experiment' ORDER BY candidate, ordinal",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pass": {
                        "text": "pass",
                        "color": "#37872d",
                        "index": 0
                      },
                      "FAIL": {
                        "text": "FAIL",
                        "color": "#e02f44",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
