{
  "uid": "rc-live",
  "title": "Rollout Cost Lab \u00b7 Live run",
  "tags": [
    "rollout-cost",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "run",
        "label": "Run",
        "datasource": {
          "type": "prometheus",
          "uid": "rc-prometheus"
        },
        "query": {
          "query": "label_values(rc_run_info, run_id)",
          "refId": "run"
        },
        "definition": "label_values(rc_run_info, run_id)",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Live run** \u2014 runner metrics (`rc_*`) and vLLM server metrics. Values for mock or scripted runs are SYNTHETIC. The runner exports while a run is in progress; between runs the panels go quiet."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Phase",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rc-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rc-prometheus"
          },
          "expr": "max by (phase) (rc_run_phase{run_id=\"$run\"}) == 1",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Episodes graded",
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rc-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rc-prometheus"
          },
          "expr": "sum(rc_episodes_terminal_total{run_id=\"$run\"}) or vector(0)",
          "legendFormat": "graded",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
